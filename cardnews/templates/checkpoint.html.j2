{% extends "base.html.j2" %}
{% block page %}
<div class="page page--checkpoint">
  <div class="checkpoint-chip">{{ page.chip }}</div>
  <div class="checkpoint-num">{{ page.number }}</div>

  <div class="checkpoint-headline">
    <div class="checkpoint-label">{{ page.label }}</div>
    <div class="checkpoint-count">{{ page.count }}</div>
  </div>

  <div class="checkpoint-tip">{{ page.tip }}</div>

  <div class="checkpoint-why-who">
    <div class="checkpoint-why">
      <span class="checkpoint-tag">왜 짚어볼까</span>
      <span class="checkpoint-why-text">{{ page.why_note }}</span>
    </div>
    <div class="checkpoint-who">
      <span class="checkpoint-tag">누가 특히</span>
      <span class="checkpoint-who-text">{{ page.who_note }}</span>
    </div>
  </div>

  {% if page.aux_block %}
  <div class="aux-block">
    <div class="aux-block-title">{{ page.aux_block.title }}</div>
    <div class="aux-block-text">{{ page.aux_block.text }}</div>
  </div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
