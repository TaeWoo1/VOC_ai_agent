{% extends "base.html.j2" %}
{% block page %}
<div class="page page--hook">
  <div class="hook-chip">{{ page.chip }}</div>

  {% if page.mini_metrics %}
  <div class="hook-metrics">
    {% for m in page.mini_metrics %}
    <div class="hook-metric">
      <div class="hook-metric-value">{{ m.value }}</div>
      <div class="hook-metric-label">{{ m.label }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="hook-lead">{{ page.lead_line }}</div>

  {% if page.supporting_lines %}
  <div class="hook-supporting">
    {% for line in page.supporting_lines %}
    <div class="hook-line"><span class="hook-line-bar"></span>{{ line }}</div>
    {% endfor %}
  </div>
  {% endif %}

  {% if page.note %}
  <div class="hook-closer">{{ page.note }} →</div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
