{% extends "base.html.j2" %}
{% block page %}
<div class="page page--positive-spotlight">
  <div class="spotlight-chip spotlight-chip--positive">{{ page.chip }}</div>
  <h1 class="spotlight-headline">{{ page.headline }}</h1>
  <div class="spotlight-count">{{ page.count }}</div>

  <div class="spotlight-body">
    <p class="spotlight-what">{{ page.what_reviewers_liked }}</p>
  </div>

  <div class="spotlight-grid">
    <div class="spotlight-aside">
      <div class="spotlight-aside-label">왜 중요한가</div>
      <div class="spotlight-aside-note">{{ page.why_it_matters }}</div>
    </div>
    <div class="spotlight-aside">
      <div class="spotlight-aside-label">누가 좋아할까</div>
      <div class="spotlight-aside-note">{{ page.who_benefits }}</div>
    </div>
  </div>

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
