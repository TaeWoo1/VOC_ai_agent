{% extends "base.html.j2" %}
{% block page %}
<div class="page page--method">
  <div class="method-chip">{{ page.chip }}</div>
  <h1 class="method-title">{{ page.title }}</h1>
  {% if page.subtitle %}<div class="method-subtitle">{{ page.subtitle }}</div>{% endif %}

  {% if page.mini_cards %}
  <div class="method-cards">
    {% for c in page.mini_cards %}
    <div class="method-card">
      <div class="method-card-label">{{ c.label }}</div>
      <div class="method-card-value">{{ c.value }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if page.note %}
  <div class="method-note">{{ page.note }}</div>
  {% endif %}

  {% if page.disclosure %}
  <div class="method-disclosure">{{ page.disclosure }}</div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
