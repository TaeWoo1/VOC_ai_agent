{% extends "base.html.j2" %}
{% block page %}
<div class="page page--one-liner">
  <div class="one-liner-chip">{{ page.chip }}</div>
  <div class="one-liner-body">
    <h1 class="one-liner-headline">{{ page.headline }}</h1>
    {% if page.sub %}<div class="one-liner-sub">{{ page.sub }}</div>{% endif %}
  </div>

  {% if page.metric_pills %}
  <div class="one-liner-pills">
    {% for p in page.metric_pills %}
    <div class="one-liner-pill">{{ p }}</div>
    {% endfor %}
  </div>
  {% endif %}

  {% if page.framing_note %}
  <div class="one-liner-framing">
    <div class="one-liner-framing-marker">왜 이렇게 봐야 할까</div>
    <div class="one-liner-framing-text">{{ page.framing_note }}</div>
  </div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
