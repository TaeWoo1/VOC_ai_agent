{% extends "base.html.j2" %}
{% block page %}
<div class="page page--signature">
  <div class="signature-rule"></div>
  <div class="signature-chip">{{ page.chip }}</div>
  <h1 class="signature-headline">{{ page.headline }}</h1>
  {% if page.subtitle %}<div class="signature-meta">{{ page.subtitle }}</div>{% endif %}
  {% if page.lead %}<p class="signature-context">{{ page.lead }}</p>{% endif %}

  {% if page.aside_items %}
  <div class="signature-grid">
    {% for it in page.aside_items %}
    <div class="signature-aside">
      <div class="signature-aside-label">{{ it.label }}</div>
      <div class="signature-aside-note">{{ it.note }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
