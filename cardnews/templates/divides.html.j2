{% extends "base.html.j2" %}
{% block page %}
<div class="page page--divides">
  <div class="divides-chip">{{ page.chip }}</div>
  <h1 class="divides-title">{{ page.title }}</h1>
  {% if page.subtitle and page.subtitle != page.title %}<div class="divides-subtitle">{{ page.subtitle }}</div>{% endif %}

  {% if page.comparison_items %}
  <div class="divides-list">
    {% for it in page.comparison_items %}
    <div class="divides-row">
      <div class="divides-row-head">
        <div class="divides-row-label">{{ it.label }}</div>
        <div class="divides-row-counts">
          <span class="divides-count divides-count--sat">만족 {{ it.satisfied }}</span>
          <span class="divides-count divides-count--split">갈림 {{ it.split }}</span>
        </div>
      </div>
      <div class="divides-bar">
        <div class="divides-bar-sat" style="width: {{ it.satisfied_pct }}%;"></div>
        <div class="divides-bar-split" style="width: {{ it.split_pct }}%;"></div>
      </div>
      {% if it.note %}<div class="divides-row-note">{{ it.note }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
