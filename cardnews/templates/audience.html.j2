{% extends "base.html.j2" %}
{% block page %}
<div class="page page--audience">
  <div class="audience-chip">{{ page.chip }}</div>
  <h1 class="audience-title">{{ page.title }}</h1>
  {% if page.subtitle %}<div class="audience-subtitle">{{ page.subtitle }}</div>{% endif %}

  <div class="audience-grid">
    <div class="audience-col audience-col--fit">
      <div class="audience-col-header">
        <span class="audience-col-tag audience-col-tag--fit">잘 맞는 분</span>
      </div>
      <div class="audience-col-body">
        {% for it in page.fit_items %}
        <div class="audience-card audience-card--fit">
          <div class="audience-card-label">{{ it.label }}</div>
          <div class="audience-card-note">{{ it.note }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="audience-col audience-col--consider">
      <div class="audience-col-header">
        <span class="audience-col-tag audience-col-tag--consider">신중하게 볼 분</span>
      </div>
      <div class="audience-col-body">
        {% for it in page.consider_items %}
        <div class="audience-card audience-card--consider">
          <div class="audience-card-label">{{ it.label }}</div>
          <div class="audience-card-note">{{ it.note }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
