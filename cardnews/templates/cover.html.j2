{% extends "base.html.j2" %}
{% block page %}
{% set has_image = page.product_image and page.product_image.local_path %}
{% set img_usage = (page.product_image.usage if page.product_image else 'cover_full_bleed') %}
{% set is_cutout = has_image and img_usage == 'cover_cutout' %}
{% set is_full_bleed = has_image and img_usage == 'cover_full_bleed' %}
<div class="page page--cover {% if not has_image %}cover--no-image{% endif %} {% if is_cutout %}cover--cutout-mode{% endif %} {% if is_full_bleed %}cover--full-bleed-mode{% endif %}">
  {% if is_full_bleed %}
  <div class="cover-photo-slot"
       style="background-image: url('file://{{ page.product_image.local_path }}');">
  </div>
  {% endif %}
  <div class="cover-grain"></div>
  <div class="cover-content">
    <div class="cover-tag">{{ page.chip }}</div>
    <div class="cover-foot">
      <h1 class="cover-headline">{{ page.headline }}</h1>
      <div class="cover-subline">{{ page.subtitle }}</div>
      {% if page.chip_strip %}
      <div class="cover-chip-strip">
        {% for c in page.chip_strip %}
        <span class="cover-chip">#{{ c }}</span>
        {% endfor %}
      </div>
      {% endif %}
      {% if page.corpus_footer %}
      <div class="cover-corpus-footer">{{ page.corpus_footer }}</div>
      {% endif %}
    </div>
  </div>
  {% if is_cutout %}
  <div class="cover-product-cutout">
    <img class="cover-product-cutout-img"
         src="file://{{ page.product_image.local_path }}"
         alt="{{ page.title }}" />
  </div>
  {% endif %}
</div>
{% endblock %}
