{% extends "base.html.j2" %}
{% block page %}
<div class="page page--caution-spotlight">
  <div class="spotlight-chip spotlight-chip--caution">{{ page.chip }}</div>
  <h1 class="spotlight-headline">{{ page.headline }}</h1>
  <div class="spotlight-count">{{ page.split_signal }}</div>

  {% if page.interpretation %}
  <div class="spotlight-body">
    <p class="spotlight-what">{{ page.interpretation }}</p>
  </div>
  {% endif %}

  <div class="spotlight-grid">
    <div class="spotlight-aside">
      <div class="spotlight-aside-label">왜 갈렸을까</div>
      <div class="spotlight-aside-note">{{ page.likely_context }}</div>
    </div>
    <div class="spotlight-aside">
      <div class="spotlight-aside-label">구매 전 체크</div>
      <div class="spotlight-aside-note">{{ page.check_before_buy }}</div>
    </div>
  </div>

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
