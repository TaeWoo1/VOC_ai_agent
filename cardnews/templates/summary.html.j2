{% extends "base.html.j2" %}
{% block page %}
<div class="page page--summary">
  <div class="summary-chip">{{ page.chip }}</div>
  <h1 class="summary-headline">{{ page.headline }}</h1>

  {% if page.one_liner_conclusion %}
  <div class="summary-conclusion">
    <div class="summary-conclusion-tag">한 줄 결론</div>
    <div class="summary-conclusion-text">{{ page.one_liner_conclusion }}</div>
  </div>
  {% endif %}

  {% if page.takeaways %}
  <div class="summary-list">
    <div class="summary-list-tag">구매 전 볼 것</div>
    {% for t in page.takeaways %}
    <div class="summary-row">
      <div class="summary-row-num">{{ '%02d'|format(loop.index) }}</div>
      <div class="summary-row-text">{{ t }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if page.closing_note %}
  <div class="summary-closing">{{ page.closing_note }}</div>
  {% endif %}

  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
