{% extends "base.html.j2" %}
{% block page %}
<div class="page page--content">
  {% if page.chip %}<div class="content-chip">{{ page.chip }}</div>{% endif %}
  <h1 class="content-title">{{ page.title }}</h1>
  {% if page.subtitle %}<div class="content-subtitle">{{ page.subtitle }}</div>{% endif %}
  {% if page.bullets %}
  <div class="content-bullets">
    {% for b in page.bullets %}
    <div class="bullet-card">{{ b }}</div>
    {% endfor %}
  </div>
  {% endif %}
  {% if page.disclosure %}
  <div class="content-disclosure">{{ page.disclosure }}</div>
  {% endif %}
  <div class="page-index">— {{ page.index }} / {{ total_pages }} —</div>
</div>
{% endblock %}
