# Backend-only env template (for running ./gradlew bootRun against a local
# Postgres). When using docker compose at the repo root, the DB/JWT values
# come from the root .env instead.
#
# Copy to `backend/.env.local` (git-ignored at every level) and fill in real
# values THERE, never here. Spring Boot does not read .env files by itself —
# load the file into your shell before starting the backend:
#
#   set -a; source backend/.env.local; set +a
#   (cd backend && ./gradlew bootRun)
#
# NEVER commit a filled-in copy. Only *.example templates belong in git.
# Full walkthrough: docs/sellerops_local_env_setup.md

# ── Backend profile / runtime ────────────────────────────────────────────────
# No Spring profile is needed for local runs (the "test" profile is used only
# by the test suite). Leave unset unless you know you need one.
# SPRING_PROFILES_ACTIVE=

# ── Database (local PostgreSQL — same values the docker-compose stack uses) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sellerops
SPRING_DATASOURCE_USERNAME=sellerops
SPRING_DATASOURCE_PASSWORD=sellerops_local_pw

# ── JWT / CORS ───────────────────────────────────────────────────────────────
# Long random string. The fallback baked into application.yml is dev-only.
SELLEROPS_JWT_SECRET=change-me-local-dev-only-please-use-a-long-random-string
SELLEROPS_JWT_EXP_MINUTES=720
SELLEROPS_CORS_ORIGIN=http://localhost:5173

# ── Social login (optional; docs/auth_growth_instrumentation_v1.md §8) ───────
# A provider exists only when BOTH values are set. Redirect URI to register at the provider console:
#   {public origin}/login/oauth2/code/google   and   {public origin}/login/oauth2/code/naver
# (dev public origin = http://localhost:5173, through the vite proxy).
SELLEROPS_OAUTH_GOOGLE_CLIENT_ID=
SELLEROPS_OAUTH_GOOGLE_CLIENT_SECRET=
SELLEROPS_OAUTH_NAVER_CLIENT_ID=
SELLEROPS_OAUTH_NAVER_CLIENT_SECRET=

# ── Credential vault master key ──────────────────────────────────────────────
# base64-encoded 32 bytes (AES-256-GCM envelope key). Local throwaway only —
# generate one with:
#   openssl rand -base64 32
# Empty = the vault fails closed (fine until credentials are actually stored).
SELLEROPS_VAULT_MASTER_KEY=
# SELLEROPS_VAULT_KEY_ID=local-dev-1

# ── Collection scheduler — keep OFF for the smoke (manual sync only) ─────────
SELLEROPS_COLLECT_SCHEDULER_ENABLED=false

# ── Demo data seed ───────────────────────────────────────────────────────────
# Baseline (demo org + login user + channels) always seeds on an empty DB so you
# can log in. Sample products/reviews/inquiries/order-summaries are OFF by default
# so a real DB shows an honest empty inbox/orders. Set true on a CLEAN DB for the
# full demo (it only seeds on first startup of an empty database).
# To reset a dev DB: drop & recreate it (Flyway re-migrates), or delete only the
# seeded rows (they have NULL external_id AND NULL content_hash; uploaded rows do
# not), then restart.
# SELLEROPS_SEED_DEMO_CONTENT=false

# ── Naver connector feature flag ─────────────────────────────────────────────
# Keep false until the authorized live-smoke session itself. Flip to true only
# for that run, and set it back to false afterwards (runbook §I rollback).
SELLEROPS_CONNECTOR_NAVER_ENABLED=false
# SELLEROPS_CONNECTOR_NAVER_BASE_URL=https://api.commerce.naver.com
# SELLEROPS_CONNECTOR_NAVER_RATE_LIMIT_RPS=2

# ── Naver Commerce API credentials (operator-supplied, throwaway) ────────────
# The backend NEVER reads these two variables. They exist only so the
# operator's shell can submit them ONCE to the write-only credential intake
# API (docs/sellerops_local_env_setup.md §6):
#   POST /api/seller-accounts/{accountId}/credentials
# After that, the connector reads them from the encrypted CredentialVault —
# never from the environment. client_secret is the bcrypt-salt-format string
# Naver issues; that format is expected.
NAVER_COMMERCE_CLIENT_ID=replace-me
NAVER_COMMERCE_CLIENT_SECRET=replace-me

# ── Optional live-smoke targets (filled during the smoke session) ────────────
# Seller-account id of the seeded NAVER account, from GET /api/seller-accounts.
# SMOKE_SELLER_ACCOUNT_ID=

# ── AI triage pilot (contracts/review-eval/naver/v2/RUBRIC.md §13.7) ──────────
# OFF by default. Opt-in per organisation; an org not listed sees exactly what
# it saw before the pilot existed. NAVER only, additive 확인 필요 mark only, no
# marketplace write, no automatic classification on import — every run is a
# bounded POST an operator sends. The key lives HERE (git-ignored) and in the
# backend's memory; it is never logged, stored, or part of any version string.
# The other knobs default to frozen candidate C2 in application.yml — changing
# one is running a different candidate and needs a change-log row.
# SELLEROPS_AI_TRIAGE_PILOT_ENABLED=true
# SELLEROPS_AI_TRIAGE_PILOT_ORG_IDS=<org uuid>[,<org uuid>]
# SELLEROPS_AI_TRIAGE_API_KEY=

# ── Operator Graph v1 — goal interpretation + evidence judging (docs/sellerops_operator_graph_v1.md §9) ──
# THREE independent LLM capabilities now live in this backend, each with its own switch and its own key,
# because each sends something different and a deployment must be able to run any subset:
#   draft  — an INQUIRY's title and body            (SELLEROPS_AGENT_DRAFT_*, above in application.yml)
#   plan   — the OPERATOR'S OWN typed sentence + a static tool catalogue. No seller row at all.
#   judge  — a sentence SellerOps composed + closed-vocabulary evidence metadata. No customer text; a
#            digest that is not key=value metadata is refused before the call (EvidenceDigestFloor).
# All OFF by default. With plan off, goal routing is the deterministic keyword table and the four demo
# goals still answer. With judge off, the deterministic rule judge decides — and it is the conservative
# one, so turning either off makes the Operator quieter, never bolder. Keys live HERE (git-ignored) and
# in memory only; they are never logged, stored, or part of any version string.
# SELLEROPS_AGENT_PLAN_ENABLED=true
# SELLEROPS_AGENT_PLAN_ORG_IDS=<org uuid>[,<org uuid>]   # or * for a local single-user deployment
# SELLEROPS_AGENT_PLAN_API_KEY=
# SELLEROPS_AGENT_JUDGE_ENABLED=true
# SELLEROPS_AGENT_JUDGE_ORG_IDS=<org uuid>[,<org uuid>]
# SELLEROPS_AGENT_JUDGE_API_KEY=
#
# ── Semantic knowledge retrieval (Knowledge Retrieval Quality v1) ───────────
# The seventh capability, and the only one that sends something on every SEARCH: the seller's own
# knowledge passages (once each, cached by content) and the CUSTOMER'S QUESTION (per search, never
# stored). The second is new for paths that call no model today, so it is off by default and turning
# it on is a deployment decision. Off ⇒ the lexical scorer answers exactly as it always has.
# SELLEROPS_KNOWLEDGE_EMBEDDING_ENABLED=true
# SELLEROPS_KNOWLEDGE_EMBEDDING_ORG_IDS=<org uuid>[,<org uuid>]   # or * for a local single-user deployment
# SELLEROPS_KNOWLEDGE_EMBEDDING_API_KEY=
# SELLEROPS_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-large
# SELLEROPS_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
#
# The eighth capability: retrieval intent. One customer sentence leaves and is restated as what it
# needs answered, so a colloquial complaint and the seller's formal note can meet. Nothing is stored.
# SELLEROPS_KNOWLEDGE_INTENT_ENABLED=true
# SELLEROPS_KNOWLEDGE_INTENT_ORG_IDS=<org uuid>[,<org uuid>]
# SELLEROPS_KNOWLEDGE_INTENT_API_KEY=
# SELLEROPS_KNOWLEDGE_INTENT_MODEL=gpt-5-2025-08-07
#
# The ninth: evidence eligibility, refusal-only. The customer's sentence and the candidate passages
# travel in ONE request, which is wider than either neighbour — its own flag, its own key.
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_ENABLED=true
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_ORG_IDS=<org uuid>[,<org uuid>]
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_API_KEY=
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_MODEL=gpt-5-2025-08-07
#
# Customer-memory retrieval is NOT an LLM capability and needs no key: it is deterministic and lexical
# over closed vocabulary that never leaves this database. The port exists so a different strategy can
# replace it; an embedding one would be a new data exposure and is out of scope by v1.12.
# SELLEROPS_CUSTOMER_MEMORY_RETRIEVER=lexical

# ── Service Readiness v1 (docs/service_readiness_v1.md §5) ───────────────────
# Error monitoring: unset = OFF (nothing initialises). PII/secrets are scrubbed in code before send.
# SENTRY_DSN=
# SELLEROPS_ENV=local
# SELLEROPS_RELEASE=            # default: git SHA recorded at build
# SELLEROPS_SENTRY_TRACES_SAMPLE_RATE=0.1
# Password reset mail. off (default) hides the "비밀번호를 잊으셨나요?" entry; dev-outbox writes the mail
# (with the one-time link) to the backend log — local/self-pilot only; smtp needs SPRING_MAIL_*.
# SELLEROPS_MAIL_MODE=off
# SELLEROPS_MAIL_FROM=no-reply@localhost
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Public origin of the frontend — mailed links are built from it.
# SELLEROPS_PUBLIC_BASE_URL=http://localhost:5173
# SELLEROPS_PASSWORD_RESET_TTL_SECONDS=1800

# ── Inquiry semantic signature (Operator Graph v2) ──────────────────────────────────────────────
# The FOURTH LLM capability, and the heaviest exposure of the four: it sends ONE CUSTOMER'S OWN inquiry
# text and receives two closed-vocabulary labels. Its own flag and its own key, because a deployment
# that wants goal interpretation must not thereby be sending customer questions to a vendor.
# A text is classified AT MOST ONCE ever (content-hash cache) — a privacy control before a cost one.
SELLEROPS_INQUIRY_SIGNATURE_ENABLED=
SELLEROPS_INQUIRY_SIGNATURE_ORG_IDS=
SELLEROPS_INQUIRY_SIGNATURE_VENDOR=
SELLEROPS_INQUIRY_SIGNATURE_MODEL=
SELLEROPS_INQUIRY_SIGNATURE_API_KEY=
SELLEROPS_INQUIRY_SIGNATURE_MAX_OUTPUT_TOKENS=
SELLEROPS_INQUIRY_SIGNATURE_REASONING_EFFORT=
SELLEROPS_INQUIRY_SIGNATURE_MAX_TEXT_CHARS=
SELLEROPS_INQUIRY_SIGNATURE_MAX_BATCH=

# ── Channel PRODUCT reads (Operator Graph v2) ───────────────────────────────────────────────────
# Cafe24 needs `mall.read_product`, which connections made before v2 did NOT grant — a token without it
# mints fine and the product read returns insufficient_scope. That is a seller re-consent, never worked
# around. NAVER needs the product API permission on the seller's own application. Neither has a new
# key: both reuse the connection the seller already made.
SELLEROPS_CONNECTOR_CAFE24_OAUTH_SCOPES=
