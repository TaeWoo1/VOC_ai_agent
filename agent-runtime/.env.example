# Agent Runtime HTTP service — environment configuration.
#
# The service holds NO channel credential and NO JWT signing secret: it only forwards the
# operator's bearer token (received from the frontend) to the backend, which derives the org from
# that token. So nothing here is a secret — copy to `.env` and adjust for local dev.

# Port the HTTP service listens on.
AGENT_RUNTIME_PORT=8787

# Base URL of the Spring backend (the system of record). Server-to-server hop; no CORS involved.
SELLEROPS_BASE_URL=http://127.0.0.1:8080

# Runtime environment: development | test | production.
# NOTE: production requires the backend-owned "spring" run store and FAILS CLOSED at boot on a
# file/memory store (those are single-instance/non-durable). Use spring for pilot/production.
APP_ENV=development

# Durable run store:
#   spring — backend-owned, org-isolated, optimistic-locked; durable AND multi-instance-safe (production);
#   file   — local single-instance JSON store; survives restart, unsafe for >1 replica (dev/proof);
#   memory — same-process only (tests).
# The spring store needs SELLEROPS_BASE_URL reachable and the backend migrated (V33+); it reaches the
# backend ONLY over /api/agent-run-store, forwarding the operator bearer — it never opens a database.
AGENT_RUNTIME_RUNSTORE_KIND=file
# Used only by the file store.
AGENT_RUNTIME_RUNSTORE_DIR=./.runstore

# Browser origins allowed to call this service (comma-separated). The Vite frontend origin(s).
# The backend hop is server-to-server and needs no CORS; this is only for the browser → runtime hop.
AGENT_RUNTIME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
