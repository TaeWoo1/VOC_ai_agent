# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment (unanchored: matches at every level, e.g. backend/.env too).
# Real local env files are never committed; only *.example templates are.
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data persistence (local dev)
chroma_data/
voc_data.db
uploads/

# Phase 2E snapshot trend artifacts (generated per pipeline run, local dev)
data/phase2e_snapshots/

# Phase 1 report outputs (generated, local dev)
reports/

# Pipeline run artifacts (analysis_report, content_plan, layout, manifest,
# cardnews PNGs) — every run lands under outputs/content_packages/<run>/.
# Treated as runtime artifacts; not committed.
outputs/

# Coupang beauty scrape artifacts + debug dumps from scripts/scrape_coupang_reviews.py
coupang/coupang_blush_*.csv
coupang/coupang_blush_*.jsonl
debug_dumps/

# SQLite working files (any *.db plus WAL/SHM siblings)
*.db
*.db-shm
*.db-wal

# Industrial review-ops local workspace store (Slice A; local demo only)
.review_ops_data/

# Operator-provided product detail images (consumer-visible source input;
# never commit — used by the local detail-image snapshot ingest)
/data/

# Root-level runtime state + scratch
/retry_queue.json
/test.py
/logs/

# Generated cardnews renders (per-account Instagram output)
cardnews/Instagram/

# Generated PDF reports living under docs/ (do not blanket-ignore docs/)
docs/*.pdf

# Coupang scrape artifacts (broaden beyond coupang_blush_* above)
coupang/*.csv
coupang/*.jsonl
coupang/*.txt
coupang/*.ipynb
coupang/.DS_Store
!coupang/.gitkeep

# Data subtrees that are runtime-only (do not blanket-ignore data/ —
# phase1_lexicons and other curated subdirs must remain trackable)
data/collection_artifacts/
data/diagnostics/
data/*.db
data/*.db-shm
data/*.db-wal
data/.DS_Store

# Eval results (tracked selectively)
eval_data/results/*.json
eval_data/.DS_Store

# Claude Code: narrow ignore — track shared agent definitions and the
# /orchestrate slash command so docs/agent_orchestration_playbook.md §11
# stays truthful in fresh clones. Everything else under .claude/ stays
# per-clone (settings, skills, other commands).
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/commands/
.claude/commands/*
!.claude/commands/orchestrate.md

# OS
.DS_Store
Thumbs.db
.Rhistory
# Added by code-review-graph
.code-review-graph/

# ──────────────────────────────────────────────────────────────────────────
# SellerOps AI (new primary product — Java/React monorepo at repo root)
# ──────────────────────────────────────────────────────────────────────────
# Backend (Spring Boot / Gradle)
backend/.gradle/
backend/build/
backend/bin/
backend/out/
# Frontend (React / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
# Local stack env (compose reads root .env; keep .env.example tracked)
.env.sellerops
docker-compose.override.yml
# Operator-provided data dumps / upload fixtures at repo root (never commit).
# Scoped to root so test resources under src/test/** stay trackable.
/*.xlsx
/*.csv

# Operator-provided seller-center review export samples (raw; may contain
# reviewer / order PII) — used locally for schema analysis, never committed.
naver/
