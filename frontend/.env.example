# Frontend env (Vite). For local `npm run dev`.
#
# LEAVE VITE_API_BASE_URL UNSET for local dev. The app then calls same-origin `/api/*`, which the Vite dev
# server proxies to the backend (see vite.config.ts). This avoids two real failure modes: a stale absolute
# API port, and a localhost/127.0.0.1 CORS mismatch. To point the dev proxy at a different backend port
# (e.g. a disposable walkthrough backend on :18090), export SELLEROPS_BACKEND_ORIGIN before `npm run dev`:
#   SELLEROPS_BACKEND_ORIGIN=http://127.0.0.1:18090 npm run dev
# Set VITE_API_BASE_URL ONLY for a deployment where the API lives on a different origin than the app.
# VITE_API_BASE_URL=https://api.example.com
# Set to "true" to render seeded mock data with no backend running.
VITE_USE_MOCKS=false
# Agent Runtime HTTP service (separate-origin Node orchestration service). The 운영 에이전트
# (/agent) page calls this; it forwards the same operator JWT to the backend.
VITE_AGENT_RUNTIME_URL=http://127.0.0.1:8787
