# Frontend env (Vite). For local `npm run dev`.
VITE_API_BASE_URL=http://localhost:8080
# Set to "true" to render seeded mock data with no backend running.
VITE_USE_MOCKS=false
# Agent Runtime HTTP service (separate-origin Node orchestration service). The 운영 에이전트
# (/agent) page calls this; it forwards the same operator JWT to the backend.
VITE_AGENT_RUNTIME_URL=http://127.0.0.1:8787
