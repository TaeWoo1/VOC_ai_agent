{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voc-intelligence.local/schemas/analysis_report.schema.json",
  "title": "VOC Analysis Report",
  "description": "Contract surface that the content engine (seller PDF + buyer content) reads from analysis_report.json. analysis_report.json is the single source of truth; the content engine never re-runs Stage 1, Stage 2, or aggregation. Fields not listed here MAY appear (forward-compat: additionalProperties=true at every level) but consumers must NOT depend on them.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "product", "corpus", "attributes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semver-style version of the analysis_report contract. Bumping the major version is a breaking change; the content engine refuses to consume an incompatible major.",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of when the analysis report was produced."
    },
    "product": {
      "type": "object",
      "additionalProperties": true,
      "required": ["slug"],
      "properties": {
        "slug": {"type": "string", "description": "Filesystem-safe slug (see src/voc/content/paths.py::slugify)."},
        "name_ko": {"type": "string"},
        "name_en": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["n_reviews_total", "primary_sort", "confidence_level", "signal_stability"],
      "properties": {
        "n_reviews_total": {"type": "integer", "minimum": 0},
        "n_reviews_analyzed": {"type": ["integer", "null"], "minimum": 0},
        "primary_sort": {"type": "string", "description": "Canonical primary sort (e.g. DATETIME_DESC). Drives comparability."},
        "sampling_strategy": {
          "type": "string",
          "enum": [
            "latest_only",
            "latest_plus_signal",
            "full_corpus",
            "incremental",
            "observable_multi_sort_corpus"
          ]
        },
        "corpus_type": {"type": "string", "enum": ["observed_scrape", "uploaded_csv", "synthetic_fixture"]},
        "confidence_level": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Coverage-based corpus confidence: high (n>=1000 + coverage>=0.5), medium (n>=300), low otherwise."
        },
        "signal_stability": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Method+size based signal stability. Independent of confidence_level."
        },
        "confidence_axes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Four-axis confidence breakdown — sample_size_confidence / collection_completeness / negative_signal_coverage / evidence_reliability — each carrying a `level` and Korean label/note. See src/voc/content/confidence_axes.py.",
          "properties": {
            "sample_size_confidence": {"type": "object", "additionalProperties": true},
            "collection_completeness": {"type": "object", "additionalProperties": true},
            "negative_signal_coverage": {"type": "object", "additionalProperties": true},
            "evidence_reliability": {"type": "object", "additionalProperties": true},
            "headline_caution": {"type": ["string", "null"]}
          }
        },
        "observation_window": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "start": {"type": ["string", "null"], "format": "date"},
            "end": {"type": ["string", "null"], "format": "date"}
          }
        }
      }
    },
    "attributes": {
      "type": "array",
      "description": "Per-attribute aggregated polarity counts and evidence. Detector and aggregation are protected; this surface is read-only.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "n_positive", "n_negative", "evidence_score"],
        "properties": {
          "key": {
            "type": "string",
            "description": "One of the 12 canonical Phase 2E attribute keys (pigmentation, persistence, ...)."
          },
          "label_ko": {"type": "string"},
          "n_positive": {"type": "integer", "minimum": 0},
          "n_negative": {"type": "integer", "minimum": 0},
          "n_mixed": {"type": "integer", "minimum": 0},
          "evidence_score": {"type": "number"},
          "polarity_share": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "positive": {"type": "number", "minimum": 0, "maximum": 1},
              "negative": {"type": "number", "minimum": 0, "maximum": 1},
              "mixed": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "tier": {"type": ["string", "null"]},
          "top_quotes": {
            "type": "array",
            "items": {"$ref": "#/$defs/quote"}
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["attribute_key"],
        "properties": {
          "attribute_key": {"type": "string"},
          "supporting_count": {"type": "integer", "minimum": 0},
          "theme_keywords_ko": {"type": "array", "items": {"type": "string"}},
          "representative_quote": {"$ref": "#/$defs/quote"}
        }
      }
    },
    "monitoring_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["attribute_key"],
        "properties": {
          "attribute_key": {"type": "string"},
          "concern_label_ko": {"type": "string"},
          "internal_check_questions_ko": {"type": "array", "items": {"type": "string"}},
          "impact_framing_ko": {"type": ["string", "null"]},
          "decision_hint_ko": {"type": ["string", "null"]},
          "n_negative": {"type": "integer", "minimum": 0},
          "top_negative_quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}}
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["pair", "count"],
        "properties": {
          "pair": {"type": "string", "description": "Format: 'attr_a:polarity_a -> attr_b:polarity_b'"},
          "count": {"type": "integer", "minimum": 0},
          "representative_quote": {"$ref": "#/$defs/quote"}
        }
      }
    },
    "usage_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "sentence_ko", "evidence_count"],
        "properties": {
          "kind": {"type": "string", "enum": ["contradiction", "usage_context", "tradeoff"]},
          "sentence_ko": {"type": "string"},
          "evidence_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "buyer_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["segment_kind", "label_ko"],
        "properties": {
          "segment_kind": {"type": "string", "enum": ["tone", "skin_type", "usage_context", "finish", "option"]},
          "label_ko": {"type": "string"},
          "dominant_count": {"type": "integer", "minimum": 0},
          "dominance_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_level": {"type": "string", "enum": ["weak", "moderate", "strong"]},
          "decision_hint_ko": {"type": ["string", "null"]},
          "supporting_quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}}
        }
      }
    },
    "quick_decision": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "verdict_ko": {"type": "string"},
        "who_for_ko": {"type": "array", "items": {"type": "string"}},
        "who_not_for_ko": {"type": "array", "items": {"type": "string"}},
        "watch_outs_ko": {"type": "array", "items": {"type": "string"}},
        "confidence_level": {"type": "string", "enum": ["weak", "moderate", "strong"]}
      }
    },
    "theme_contrasts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["pair_label_ko"],
        "properties": {
          "pair_label_ko": {"type": "string"},
          "share_a": {"type": "number", "minimum": 0, "maximum": 1},
          "share_b": {"type": "number", "minimum": 0, "maximum": 1},
          "framing_ko": {"type": ["string", "null"]}
        }
      }
    },
    "trend": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "comparability_status": {
          "type": "string",
          "enum": [
            "ok",
            "no_previous",
            "incomparable_sort",
            "incomparable_cap",
            "incomparable_corpus_type",
            "incomparable_strategy",
            "incomparable_sample_size",
            "non_primary_sort"
          ]
        },
        "top_rising": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "top_improving": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "directional_low_confidence_note": {"type": ["string", "null"]}
      }
    },
    "methodology_notes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "disclosure_ko": {"type": "string"},
        "sample_caveats_ko": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": true,
      "description": "Verbatim review excerpt with source review_id. Span boundaries preserve EvidenceUnit.text == parent_review.text[char_start:char_end] invariant.",
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "review_id": {"type": ["string", "null"]},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0},
        "polarity": {"type": ["string", "null"]},
        "rating": {"type": ["number", "null"]}
      }
    }
  }
}
