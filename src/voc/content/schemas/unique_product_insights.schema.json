{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voc-intelligence.local/schemas/unique_product_insights.schema.json",
  "title": "Unique Product Insights",
  "description": "Per-product insight extraction output. Phase E1+E2 ships only the candidate-pool and validator surfaces; the LLM-driven `insights[]` list is populated in Phase E3+. Every `evidence_quotes_ko[i]` MUST be a literal substring of the corresponding entry in `candidate_pool.bounded_review_excerpts`. The validator at `src/voc/content/unique_insights/validators.py` enforces this and the related anti-hallucination contract (no medical/efficacy claims, no superlatives, no causal attribution, every claim grounded in ≥2 distinct review_ids).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "product",
    "candidate_pool",
    "insights"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "product": {
      "type": "object",
      "additionalProperties": true,
      "required": ["slug"],
      "properties": {
        "slug": {"type": "string"},
        "name_ko": {"type": ["string", "null"]},
        "name_en": {"type": ["string", "null"]},
        "brand_ko": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "source_analysis_report_sha256": {"type": ["string", "null"]},
    "source_brief_sha256": {"type": ["string", "null"]},
    "selected_profile_id": {"type": ["string", "null"]},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "extraction_meta": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "LLM extraction audit trail. Phase E1+E2 emits null; Phase E3 populates."
    },
    "candidate_pool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "high_frequency_strengths",
        "concentrated_complaints",
        "cross_attribute_tradeoffs",
        "polarity_outliers",
        "usage_context_signals",
        "category_baseline_source",
        "baseline_caveat_ko",
        "bounded_review_excerpts"
      ],
      "properties": {
        "high_frequency_strengths": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_entry"},
          "maxItems": 5
        },
        "concentrated_complaints": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_entry"},
          "maxItems": 5
        },
        "cross_attribute_tradeoffs": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_entry"},
          "maxItems": 3
        },
        "polarity_outliers": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_entry"},
          "maxItems": 5
        },
        "usage_context_signals": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_entry"},
          "maxItems": 3
        },
        "category_baseline_source": {
          "type": "string",
          "enum": ["profile_curated", "snapshot_aggregate", "uncertain"]
        },
        "baseline_caveat_ko": {"type": "string"},
        "bounded_review_excerpts": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "{review_id: concatenated_excerpt_text}. The LLM's evidence_quotes_ko[i] MUST be a literal substring of the value at evidence_review_ids[i]."
        }
      }
    },
    "insights": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/insight"}
    },
    "validation": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "ok": {"type": "boolean"},
        "blocking_flags": {"type": "array"},
        "advisory_flags": {"type": "array"}
      }
    }
  },
  "$defs": {
    "candidate_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate_id", "attribute_key"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^cand_(strength|complaint|tradeoff|outlier|usage)_\\d{3}$",
          "description": "Stable id assigned by the candidate-pool builder. Insights cite these via `source_candidate_ids`. Format: cand_<bucket>_<NNN>."
        },
        "attribute_key": {
          "type": "string",
          "description": "Attribute key OR pair-string for tradeoffs (`attr_a:pol_a -> attr_b:pol_b`)."
        },
        "label_ko": {"type": ["string", "null"]},
        "n_pos": {"type": "integer", "minimum": 0},
        "n_neg": {"type": "integer", "minimum": 0},
        "n_mixed": {"type": "integer", "minimum": 0},
        "evidence_review_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_excerpts_preview": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Verbatim excerpts pulled from analysis_report.attributes[*].top_quotes[*].text. The LLM uses these as anchors when synthesizing insights; the validator's substring check uses the broader bounded_review_excerpts pool."
        },
        "baseline_comparison": {
          "type": ["number", "null"],
          "description": "Deviation metric vs the category profile's expected_positive_share. Null when no baseline is curated for this attribute."
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "insight_id",
        "type",
        "title_ko",
        "explanation_ko",
        "category_baseline",
        "what_makes_it_unique_ko",
        "evidence_review_ids",
        "evidence_quotes_ko",
        "source_candidate_ids",
        "confidence",
        "content_angle_score",
        "seller_report_relevance",
        "buyer_content_relevance",
        "risk_flags"
      ],
      "properties": {
        "insight_id": {
          "type": "string",
          "pattern": "^ins_\\d{3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "unique_strength",
            "unique_weakness",
            "unique_tradeoff",
            "usage_context",
            "packaging_value"
          ]
        },
        "title_ko": {"type": "string", "minLength": 1, "maxLength": 30},
        "explanation_ko": {"type": "string", "minLength": 1, "maxLength": 200},
        "category_baseline": {
          "type": "object",
          "additionalProperties": true,
          "required": ["ko", "source", "is_hypothesis"],
          "properties": {
            "ko": {"type": "string"},
            "source": {
              "type": "string",
              "enum": ["profile_curated", "snapshot_aggregate", "uncertain"]
            },
            "is_hypothesis": {"type": "boolean"}
          }
        },
        "what_makes_it_unique_ko": {"type": "string", "minLength": 1, "maxLength": 200},
        "evidence_review_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence_quotes_ko": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "source_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cand_(strength|complaint|tradeoff|outlier|usage)_\\d{3}$"
          },
          "description": "Every insight MUST reference ≥1 candidate_pool entry it derived from. Validator rejects ids not present in the pool."
        },
        "confidence": {
          "type": "string",
          "enum": ["weak", "moderate", "strong"]
        },
        "content_angle_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seller_report_relevance": {
          "type": "string",
          "enum": ["high", "moderate", "low"]
        },
        "buyer_content_relevance": {
          "type": "string",
          "enum": ["high", "moderate", "low"]
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "category_baseline_uncertain",
              "evidence_thin",
              "polarity_ambiguous",
              "low_corpus_n"
            ]
          }
        }
      }
    }
  }
}
