# Self-Pilot Runtime v1 — LOCAL AGENT env (copy to tools/self-pilot/.run/self-pilot.env; that path is
# gitignored). Names only here; every value is yours. Never commit the copy, never paste it into chat.
#
# The self-pilot ORG (the one you created with POST /api/auth/signup) — NOT the demo account.
SELLEROPS_BASE_URL=http://127.0.0.1:8080
SELLEROPS_EMAIL=
SELLEROPS_PASSWORD=
# Where the agent's boot Chrome opens SellerOps (bridge dev mode).
SELLEROPS_APP_URL=http://localhost:5173
# naver-import carrier: the 스마트스토어센터 리뷰 page URL (you log in yourself in the agent's Chrome).
NAVER_REVIEW_URL=
# coupang-locate carrier ([쿠팡에서 보기]): the WING review page URL. Leave empty until you use it.
COUPANG_WING_URL=
# Optional: a specific Chrome binary (defaults to the collector's own resolution).
# COLLECTOR_CHROME_PATH=
