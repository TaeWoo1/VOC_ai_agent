# Cafe24 local backend bootstrap — variable NAMES and usage only.
# NEVER put real values in this file or any committed file. Secrets live in the
# macOS Keychain (preferred) or the operator's shell env, and are loaded at run
# time by run-backend-local.sh. This file is documentation, not configuration.

# ---- vault master key (base64-encoded 32-byte AES-256 key) -------------------
# The key that seals connector_credentials.encrypted_payload. MUST be the SAME
# value that was used when the stored credential was created, or the pre-boot
# decryptability gate fails closed. Loaded from the Keychain by default:
#   security add-generic-password -s sellerops-vault-master-key -a local-dev-1 -w '<base64-32-bytes>'
# Backend env var (set by the run script, not by you): SELLEROPS_VAULT_MASTER_KEY
# Key id (must equal the stored credential's encryption_key_id; default local-dev-1):
#   SELLEROPS_VAULT_KEY_ID=local-dev-1

# ---- disposable database (fixed by the run script; do NOT point at real sellerops) ----
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:55432/cafe24_phaseb
# SPRING_DATASOURCE_USERNAME=sellerops
# DB password (optional under local trust auth). Keychain:
#   security add-generic-password -s sellerops-cafe24-db -a sellerops -w '<db-password>'
# Backend env var: SPRING_DATASOURCE_PASSWORD

# ---- Cafe24 OAuth app credentials (the ONE registered SellerOps app) ---------
#   security add-generic-password -s sellerops-cafe24-oauth -a client-id     -w '<client-id>'
#   security add-generic-password -s sellerops-cafe24-oauth -a client-secret -w '<client-secret>'
# Backend env vars: SELLEROPS_CONNECTOR_CAFE24_CLIENT_ID, SELLEROPS_CONNECTOR_CAFE24_CLIENT_SECRET
#
# OAuth redirect URI — MUST byte-for-byte match the callback registered on the
# Cafe24 app (e.g. a public ngrok tunnel callback, NOT http://localhost:8080/...).
# Only needed for the connect/reconnect flow. Env overrides, else Keychain:
#   security add-generic-password -s sellerops-cafe24-oauth -a redirect-uri \
#     -w 'https://<your-tunnel-host>/api/connect/cafe24/callback'
# Backend env var: SELLEROPS_CONNECTOR_CAFE24_REDIRECT_URI
# mall-id for /connect/cafe24/start (kept in Keychain so it need not be typed):
#   security add-generic-password -s sellerops-cafe24-oauth -a mall-id -w '<mall-id>'

# ---- pinned connector configuration (set by the run script) ------------------
# SELLEROPS_CONNECTOR_CAFE24_ENABLED=true
# SELLEROPS_CONNECTOR_CAFE24_API_VERSION=2025-12-01
# SELLEROPS_COLLECT_SCHEDULER_ENABLED=false
# SELLEROPS_CONNECTOR_CAFE24_DIAGNOSTIC_BOARDS_ENABLED=false

# ---- optional Keychain service-name overrides --------------------------------
# SELLEROPS_KC_MASTER_SERVICE=sellerops-vault-master-key
# SELLEROPS_KC_DB_SERVICE=sellerops-cafe24-db
# SELLEROPS_KC_OAUTH_SERVICE=sellerops-cafe24-oauth

# ---- recovery bypass (default false) -----------------------------------------
# When the correct existing master key is unrecoverable, boot ONCE with this
# true to skip the decryptability gate so a Cafe24 OAuth reconnect can re-store
# the credential under the current key. Leave unset for every normal boot.
# SELLEROPS_BOOTSTRAP_ALLOW_REKEY=false
