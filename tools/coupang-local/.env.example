# tools/coupang-local — environment for the Coupang first-connection + order-routine LIVE proof.
# Copy nothing secret into the repo. These are shell exports you set in your own terminal (or a gitignored
# file you `source`), NEVER committed. The real Coupang credential is entered ONLY in the frontend masked
# form — never here, never in a log, never in git.

# ── Vault master key (macOS Keychain, read by run-backend-local.sh) ─────────────────────────────
# Create a 32-byte AES-256 key in the login Keychain (do this once; the key never touches the repo):
#   KEY=$(openssl rand -base64 32)
#   security add-generic-password -s sellerops-vault-master-key -a coupang-proof-1 -w "$KEY"
# (override the account id with SELLEROPS_VAULT_KEY_ID; default coupang-proof-1)

# ── Disposable Postgres (NEVER the real sellerops :5432) ────────────────────────────────────────
# Bring up a throwaway DB on :55432 and create the database the backend migrates into:
#   createdb -h 127.0.0.1 -p 55432 -U sellerops coupang_proof
# export SPRING_DATASOURCE_URL="jdbc:postgresql://127.0.0.1:55432/coupang_proof"
# export PGPORT=55432 PGDATABASE=coupang_proof PGUSER=sellerops

# ── Advertised calling IP(s) you registered in your Coupang app (informational; surfaced by /setup) ──
# Comma-separated IPv4. This is what the operator eyeball-matches against the registration; the harness
# cannot read the backend's real OS egress IP, so you MUST confirm the actual outbound IP is registered.
# export SELLEROPS_CONNECTOR_COUPANG_ADVERTISED_EGRESS_IPS="203.0.113.20"

# ── Fixed ports (defaults; override only if they clash) ─────────────────────────────────────────
# export SELLEROPS_COUPANG_BACKEND_PORT=18091

# The Coupang flag, scheduler-off, real gateway base-url, and the live-call interlock arming are set by
# run-backend-local.sh from bootstrap.sh's run env — you do NOT set the approval id by hand.
