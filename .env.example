# Required — OpenAI API key for embeddings and generation
OPENAI_API_KEY=your-openai-api-key-here

# Optional — model overrides (defaults shown)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_GENERATION_MODEL=gpt-4o-mini

# Optional — server config (defaults shown)
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO

# Optional — data paths (defaults shown)
# CHROMA_PERSIST_DIR=./chroma_data
# DB_PATH=./voc_data.db

# ──────────────────────────────────────────────────────────────────────────
# SellerOps AI (new primary product) — used by docker-compose.yml at root.
# Copy to `.env` for `docker compose up`. These are non-secret local defaults.
# ──────────────────────────────────────────────────────────────────────────
# PostgreSQL
POSTGRES_DB=sellerops
POSTGRES_USER=sellerops
POSTGRES_PASSWORD=sellerops_local_pw

# Backend (Spring Boot)
# JWT signing secret — override with a long random value outside local dev.
SELLEROPS_JWT_SECRET=change-me-local-dev-only-please-use-a-long-random-string
SELLEROPS_JWT_EXP_MINUTES=720
# Frontend origin allowed by backend CORS
SELLEROPS_CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) — base URL the browser uses to reach the backend
VITE_API_BASE_URL=http://localhost:8080
# Set to "true" to force the frontend to render seeded mock data without a backend
VITE_USE_MOCKS=false

# ──────────────────────────────────────────────────────────────────────────
# Pilot Runtime Foundation v1 §3 — the environment contract.
#
# NAMES ONLY. Never commit an API key, a secret, an IP or a credential to this
# file. Copying it must produce a deployment that RUNS SAFELY, not one where
# every connector is switched on: each channel below stays OFF until somebody
# deliberately fills in its section, and a channel that is ON while its
# required values are blank refuses to start (PilotConfigValidator) rather
# than booting into a screen whose 「연결하기」 button cannot work.
# ──────────────────────────────────────────────────────────────────────────

# ── Demo fixture ──────────────────────────────────────────────────────────
# Creates the 데모 제조사 organisation and its login user on an empty database.
# Leave FALSE on anything a real seller can reach: that user's password is
# written down in this repository. `SEED_DEMO_ENTRY` decides whether the login
# screen shows the 「데모 화면 보기」 shortcut at all; it follows SEED_ENABLED
# unless set. The 13-channel catalogue is NOT gated by either and always seeds.
SELLEROPS_SEED_ENABLED=false
SELLEROPS_SEED_DEMO_CONTENT=false
# SELLEROPS_SEED_DEMO_ENTRY=false

# ── Seller sign-in with Google / NAVER (optional) ─────────────────────────
# The SELLER'S LOGIN — not the NAVER commerce connector below. Different
# console, different credential, different callback. Both values or neither:
# a half-configured provider does not exist (no bean, no endpoint, no button),
# and with both blank the login screen is email + password, as it shipped.
# Callback to register (Spring's default template, on the browser's origin):
#   Google : {origin}/login/oauth2/code/google
#   NAVER  : {origin}/login/oauth2/code/naver
SELLEROPS_OAUTH_GOOGLE_CLIENT_ID=
SELLEROPS_OAUTH_GOOGLE_CLIENT_SECRET=
SELLEROPS_OAUTH_NAVER_CLIENT_ID=
SELLEROPS_OAUTH_NAVER_CLIENT_SECRET=

# ── Credential vault (required as soon as ANY connector is on) ────────────
# Base64 of 32 random bytes (AES-256). Without it every credential save fails
# closed — after the seller's consent, on the last screen.
# SELLEROPS_VAULT_MASTER_KEY=
# SELLEROPS_VAULT_KEY_ID=

# ── Offline mock connector (a dev/test fixture; OFF unless you say otherwise) ─
# MockApiConnector SYNTHESIZES reviews and inquiries, and they are stored exactly
# like collected ones. Both switches default to false, so copying this file gives
# a deployment that collects nothing rather than one that invents. Turn the pair
# on only in a local stack you are willing to see fake rows in.
# SELLEROPS_CONNECTOR_MOCK_ENABLED=true
# SELLEROPS_CONNECTOR_MOCK_FALLBACK_ENABLED=true

# ── NAVER 스마트스토어 ─────────────────────────────────────────────────────
# The advertised egress IP is the value the connect screen tells the seller to
# register as 'API 호출 IP'. It must be THIS deployment's fixed outbound IPv4 —
# a local or staging address must never be shown to a seller.
SELLEROPS_CONNECTOR_NAVER_ENABLED=false
# SELLEROPS_CONNECTOR_NAVER_ADVERTISED_EGRESS_IPS=

# ── 쿠팡 ───────────────────────────────────────────────────────────────────
SELLEROPS_CONNECTOR_COUPANG_ENABLED=false
# Per-run live approval id (docs/sellerops_live_approval_contract.md), or use
# the self-pilot standing READ grant below.
# SELLEROPS_CONNECTOR_COUPANG_LIVE_APPROVAL_ID=

# ── 카페24 자사몰 ──────────────────────────────────────────────────────────
# REDIRECT_URI must be the fixed public HTTPS callback and must be byte-identical
# to the one registered in Cafe24 Developers. The loopback default cannot be
# reached by Cafe24, so a boot with the connector ON and this unset is refused.
SELLEROPS_CONNECTOR_CAFE24_ENABLED=false
# SELLEROPS_CONNECTOR_CAFE24_CLIENT_ID=
# SELLEROPS_CONNECTOR_CAFE24_CLIENT_SECRET=
# SELLEROPS_CONNECTOR_CAFE24_API_VERSION=
# SELLEROPS_CONNECTOR_CAFE24_REDIRECT_URI=
# SELLEROPS_CONNECTOR_CAFE24_RESULT_URL=

# ── Routine collection (Seller Operations, not an AI feature) ─────────────
# CONNECTED_SELLERS: every org that owns a CONNECTED seller account becomes a
# routine-collection target, read from the database — no per-seller UUID edit
# and no restart after a signup. ALLOW_LIST (default) needs SELF_PILOT_ORG_IDS.
SELLEROPS_SELF_PILOT_ENABLED=false
# SELLEROPS_SELF_PILOT_SCOPE=CONNECTED_SELLERS
# SELLEROPS_SELF_PILOT_DEFAULT_INTERVAL_MINUTES=60
# Standing READ grant (spr-<8..32 hex>) for Coupang signed GETs. READ only —
# every WRITE gate refuses it.
# SELLEROPS_SELF_PILOT_READ_GRANT_ID=

# ── Proactive Agent — a SEPARATE decision from keeping data fresh ─────────
# Turning routine collection on does NOT turn this on. It needs its own flag and
# its own explicit org list, and the intersection with the scope above only narrows.
SELLEROPS_PROACTIVE_ENABLED=false
# SELLEROPS_PROACTIVE_ORG_IDS=

# ── Agent AI capabilities — the /agent lane (Pilot Readiness Closure v1) ──
# NAMES ONLY; never commit a key. Each capability is a SEPARATE exposure with
# its own flag and key: PLAN sends the operator's own typed sentence, DRAFT
# sends an inquiry's text, JUDGE sends SellerOps-composed metadata. A
# deployment may run any subset. PLAN off ⇒ free-language Agent turns FAIL
# (there is no keyword planner to fall back to, by contract).
#
# ACCESS_SCOPE answers WHO, once, for all three:
#   ALLOW_LIST (default) — only the org ids listed below. Admitting a seller is
#     an env edit plus a restart, which is why it is not the pilot's value.
#   CONNECTED_SELLERS    — any org that finished a channel connection. Read from
#     the database: no env edit, no restart, and an org that connected nothing
#     spends nothing. This is the pilot value.
#   ALL_ORGS             — every org in this backend (what a bare "*" meant).
# SELLEROPS_AGENT_ACCESS_SCOPE=CONNECTED_SELLERS
SELLEROPS_AGENT_PLAN_ENABLED=false
# SELLEROPS_AGENT_PLAN_API_KEY=
# SELLEROPS_AGENT_PLAN_ORG_IDS=
SELLEROPS_AGENT_DRAFT_ENABLED=false
# SELLEROPS_AGENT_DRAFT_API_KEY=
# SELLEROPS_AGENT_DRAFT_ORG_IDS=
SELLEROPS_AGENT_JUDGE_ENABLED=false
# SELLEROPS_AGENT_JUDGE_API_KEY=
# SELLEROPS_AGENT_JUDGE_ORG_IDS=
SELLEROPS_AGENT_REPORT_ENABLED=false
# SELLEROPS_AGENT_REPORT_API_KEY=
# SELLEROPS_AGENT_REPORT_ORG_IDS=
# Semantic knowledge retrieval. Sends the seller's knowledge passages once each, and the CUSTOMER'S
# QUESTION on every search — new for paths that call no model today, hence off by default.
# These three are NOT widened by SELLEROPS_AGENT_ACCESS_SCOPE: connecting a channel admits a seller
# to the Agent, not to having their customers' questions sent to a vendor. Turning one on requires
# naming organisations in its own _ORG_IDS; on + keyed + blank is refused at boot.
SELLEROPS_KNOWLEDGE_EMBEDDING_ENABLED=false
# SELLEROPS_KNOWLEDGE_EMBEDDING_API_KEY=
# SELLEROPS_KNOWLEDGE_EMBEDDING_ORG_IDS=
# Retrieval intent: restates ONE customer sentence as what it needs answered, before embedding.
# Only questions a CUSTOMER wrote pay for it.
SELLEROPS_KNOWLEDGE_INTENT_ENABLED=false
# SELLEROPS_KNOWLEDGE_INTENT_API_KEY=
# SELLEROPS_KNOWLEDGE_INTENT_ORG_IDS=
# Evidence eligibility: a refusal-only judge after ranking. Sends the customer's sentence AND the
# seller's candidate passages in one request — a wider payload than either neighbour, hence its own key.
SELLEROPS_KNOWLEDGE_ELIGIBILITY_ENABLED=false
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_API_KEY=
# SELLEROPS_KNOWLEDGE_ELIGIBILITY_ORG_IDS=

# ── Answer execution (marketplace WRITE) ─────────────────────────────────
# OFF ⇒ no ChannelReplyAdapter bean exists and the publish core fails closed.
# Each send additionally needs its channel's live-run approval id.
SELLEROPS_INQUIRY_PUBLISH_EXECUTION_ENABLED=false
# SELLEROPS_INQUIRY_PUBLISH_NAVER_LIVE_APPROVAL_ID=
# SELLEROPS_INQUIRY_PUBLISH_CAFE24_LIVE_APPROVAL_ID=
# SELLEROPS_INQUIRY_PUBLISH_CAFE24_CLIENT_IP=
# SELLEROPS_INQUIRY_PUBLISH_CAFE24_SHOP_NO=

# ── Agent runtime (the /agent lane; docker-compose owns its lifecycle) ────
# AGENT_RUNTIME_APP_ENV=production
# AGENT_RUNTIME_RUNSTORE_KIND=spring
# AGENT_RUNTIME_CORS_ORIGINS=http://localhost:5173
# The browser's URL for the runtime; the frontend image bakes it in.
# VITE_AGENT_RUNTIME_URL=http://127.0.0.1:8787
