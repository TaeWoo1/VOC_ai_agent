{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "inquiry-resolution-plan/v3.1/plan-row",
 "title": "One need's resolution plan (gold or predicted). Vocabulary: contracts/inquiry-authority/v1/vocabulary.json; every cross-field rule — scope by capability, a procedure's effect and its order precondition, identity never asked — is enforced by tools/inquiry-need-eval/plan.mjs validatePlans and by ResolutionPlanValidator.",
 "type": "object",
 "required": [
  "q",
  "need",
  "v2_type",
  "status",
  "steps",
  "customer_inputs",
  "expected_terminal"
 ],
 "additionalProperties": false,
 "properties": {
  "q": {
   "type": "string",
   "pattern": "^[RS]:[A-Za-z0-9-]+$"
  },
  "need": {
   "type": "string",
   "pattern": "^n[0-9]+$"
  },
  "v2_type": {
   "enum": [
    "PRODUCT_SPEC",
    "PRODUCT_USAGE",
    "PRODUCT_COMPATIBILITY",
    "CATALOGUE_AVAILABILITY",
    "POLICY",
    "ORDER_STATE",
    "ORDER_ACTION",
    "SELLER_DECISION"
   ]
  },
  "status": {
   "enum": [
    "FROZEN",
    "PENDING_ADJUDICATION"
   ]
  },
  "pending_reason": {
   "type": "string"
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "$ref": "#/$defs/step"
   }
  },
  "customer_inputs": {
   "type": "array",
   "items": {
    "enum": [
     "OPTION",
     "SIZE",
     "MODEL",
     "QUANTITY",
     "USE_CONTEXT",
     "MEASUREMENT"
    ]
   }
  },
  "expected_terminal": {
   "$ref": "#/$defs/expected"
  },
  "alternatives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "steps",
     "expected_terminal"
    ],
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "$ref": "#/$defs/step"
      }
     },
     "expected_terminal": {
      "$ref": "#/$defs/expected"
     }
    }
   }
  }
 },
 "$defs": {
  "step": {
   "type": "object",
   "required": [
    "capability",
    "role",
    "scope",
    "effect"
   ],
   "additionalProperties": false,
   "properties": {
    "capability": {
     "enum": [
      "KNOWLEDGE.PRODUCT",
      "KNOWLEDGE.ORG",
      "KNOWLEDGE.CATALOGUE",
      "ENTITY.ORDER",
      "ENTITY.LISTING",
      "PROCEDURE.ORDER_ACTION",
      "SELLER"
     ]
    },
    "role": {
     "enum": [
      "CLOSES",
      "PRECONDITION",
      "CONTEXT"
     ]
    },
    "fields": {
     "type": "array",
     "items": {
      "enum": [
       "ORDER_PAYMENT",
       "ORDER_CANCELLATION",
       "ORDER_FULFILLMENT",
       "ORDER_TRACKING",
       "LISTING_SALE_STATUS",
       "LISTING_OPTION_SALE_STATUS"
      ]
     }
    },
    "depends_on": {
     "type": "integer",
     "minimum": 0
    },
    "scope": {
     "enum": [
      "THIS_LISTING",
      "SELLER_CATALOGUE",
      "THIS_ORDER",
      "COMPANY",
      "NONE"
     ]
    },
    "effect": {
     "enum": [
      "NONE",
      "EXTERNAL_STATE_CHANGE",
      "BOUNDED_WORKFLOW"
     ]
    }
   }
  },
  "expected": {
   "type": "object",
   "required": [
    "state"
   ],
   "additionalProperties": false,
   "properties": {
    "state": {
     "enum": [
      "RESOLVED",
      "RESOLVED_CONDITIONAL",
      "NEEDS_CUSTOMER_INPUT",
      "NEEDS_SELLER",
      "CAPABILITY_GAP",
      "FAILED"
     ]
    },
    "gap": {
     "enum": [
      "ACQUIRABLE",
      "DISABLED",
      "NOT_SUPPORTED",
      "UNREADABLE_SOURCE",
      "NOT_EXECUTABLE",
      "UNBOUND",
      "STALE",
      "UNPROVEN",
      "UNAVAILABLE"
     ]
    }
   }
  }
 }
}
