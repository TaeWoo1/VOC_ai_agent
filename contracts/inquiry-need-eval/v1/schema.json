{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sellerops/inquiry-need-eval/v1",
  "title": "Inquiry Need Eval v1 — row shapes of the three layers",
  "description": "L1 human gold (questions, needs, precedents) · L2 snapshot state (census) · L3 runtime observation. The validator (tools/inquiry-need-eval/validate.mjs) enforces the cross-row rules this schema cannot express; a test keeps every enum here equal to tools/inquiry-need-eval/vocabulary.mjs. Canonical definitions: docs/inquiry_need_eval_v1.md.",
  "$defs": {
    "hex8": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "ref": {
      "type": "string",
      "description": "KIND:id[#pattern]. Ids are the first 8 hex chars, unique within one org (the census refuses AMBIGUOUS).",
      "pattern": "^(PK|OK|CAT|OPT|ADDON|FACT|ORDER|IMG|C24):[^#]+(#.+)?$"
    },
    "evidenceSet": {
      "type": "object",
      "description": "All refs are needed (AND); a need's sets are alternatives (OR).",
      "required": ["refs", "suff"],
      "additionalProperties": false,
      "properties": {
        "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "suff": { "enum": ["FULL", "CONDITIONAL", "PARTIAL", "UNKNOWN"] }
      }
    },
    "question": {
      "type": "object",
      "required": ["q", "set", "cluster", "canonical", "product"],
      "properties": {
        "q": { "type": "string", "pattern": "^[RS]:" },
        "set": { "enum": ["R", "S"] },
        "cluster": { "type": "string", "description": "conversation_cluster_id — duplicates of one conversation share it" },
        "canonical": { "type": "boolean", "description": "exactly one per cluster; only canonical cases weigh in headline metrics" },
        "product": { "oneOf": [{ "$ref": "#/$defs/hex8" }, { "type": "null" }] },
        "inquiry": { "$ref": "#/$defs/hex8", "description": "R only: read by id at run time; L1 never holds a real customer sentence" },
        "text": { "type": "string", "description": "S only: synthetic question" },
        "product_via_memory": { "$ref": "#/$defs/hex8" }
      }
    },
    "need": {
      "type": "object",
      "required": ["q", "need", "ask", "type", "scope", "sets", "family_sets", "precedents", "family_precedents"],
      "properties": {
        "q": { "type": "string" },
        "need": { "type": "string", "pattern": "^n[0-9]+$" },
        "ask": { "type": "string", "minLength": 1, "maxLength": 120, "description": "in the seller's words; no customer text" },
        "type": { "enum": ["PRODUCT_SPEC", "PRODUCT_USAGE", "PRODUCT_COMPATIBILITY", "CATALOGUE_AVAILABILITY", "POLICY", "ORDER_STATE", "ORDER_ACTION", "SELLER_DECISION"] },
        "scope": { "enum": ["PRODUCT", "ORG", "ORDER", "NONE"] },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/evidenceSet" } },
        "family_sets": { "type": "array", "items": { "$ref": "#/$defs/evidenceSet" }, "description": "PRODUCT_FAMILY annotation — reachable=false" },
        "precedents": { "type": "array", "items": { "$ref": "#/$defs/hex8" } },
        "family_precedents": { "type": "array", "items": { "$ref": "#/$defs/hex8" } },
        "note": { "type": "string" }
      }
    },
    "precedent": {
      "type": "object",
      "required": ["memory", "precedent_scope"],
      "properties": {
        "memory": { "$ref": "#/$defs/hex8" },
        "precedent_scope": { "enum": ["REUSABLE", "ORDER_ONLY", "CASE_ONLY"] },
        "why": { "type": "string" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["snapshot", "dataset_hash", "refs", "memories"],
      "properties": {
        "snapshot": { "type": "string" },
        "db": { "type": "string" },
        "dataset_hash": { "type": "string" },
        "census": { "type": "object", "description": "source counts that say what the snapshot WAS" },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "product", "state"],
            "properties": {
              "ref": { "$ref": "#/$defs/ref" },
              "product": { "oneOf": [{ "$ref": "#/$defs/hex8" }, { "type": "null" }] },
              "state": { "enum": ["PRESENT", "PRESENT_OTHER_SCOPE", "ABSENT_ACQUIRABLE", "UNREADABLE", "NO_SOURCE"] }
            }
          }
        },
        "memories": { "type": "array" },
        "state_hash": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["q", "basis", "current", "memory", "precedent", "prefill_shown", "catalogue"],
      "properties": {
        "q": { "type": "string" },
        "basis": { "enum": ["GROUNDED", "NEEDS_CLARIFICATION", "NO_ANSWER_BASIS"] },
        "current": { "type": "array", "items": { "type": "object", "required": ["scope", "source"] } },
        "memory": { "type": "array", "items": { "type": "string" } },
        "precedent": { "type": ["string", "null"] },
        "prefill_shown": { "type": "boolean" },
        "catalogue": { "type": "object" },
        "variant": { "type": "object" },
        "order_state": { "type": ["string", "null"] }
      }
    }
  }
}
