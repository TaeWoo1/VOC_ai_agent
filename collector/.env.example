# Copy to .env and run the CLI with:  node --env-file=.env ...  (or export these)
# These are SellerOps credentials for the LOCAL dev backend — NOT NAVER seller
# credentials. The collector never handles NAVER passwords; NAVER login happens
# manually in the browser profile during the (separate) live slice.
#
# These four are used ONLY by the upload path (full --discover and the offline
# upload-file check). Milestone-1 runs `--discover --classify-only`, which does
# NOT upload — so these are unused and the backend does not need to be running.

SELLEROPS_BASE_URL=http://localhost:8080
SELLEROPS_EMAIL=demo@sellerops.ai
SELLEROPS_PASSWORD=demo1234
NAVER_CHANNEL_CODE=NAVER

# Optional overrides (defaults are under collector/.profile, /downloads, /.status)
# COLLECTOR_PROFILE_DIR=
# COLLECTOR_DOWNLOAD_DIR=
# COLLECTOR_STATUS_FILE=

# Browser channel for the LIVE layer. Recommended for NAVER milestone-1:
# `chrome` drives your INSTALLED Google Chrome instead of Playwright's bundled
# Chromium (a mainstream Chrome fingerprint is less likely to trip NAVER account
# security). It still uses the dedicated SellerOps profile under
# collector/.profile/naver — NOT your personal Chrome profile — so your normal
# Chrome data/sessions are untouched. Leave unset/blank to use bundled Chromium.
# COLLECTOR_BROWSER_CHANNEL=chrome

# Live layer only (not used by the offline core or offline tests). Required by
# `npm run discover -- --discover` (including --classify-only): the
# review-management/export page URL. The exact URL is confirmed during the
# approved live milestone-1 run.
# NAVER_REVIEW_URL=

# Gated integration test only: absolute path to a SYNTHETIC NAVER-shaped export
# .xlsx (fake rows, unique 리뷰글번호 ids). NEVER point this at a real seller-center
# export — the file is ingested into the local dev DB.
# RUN_INTEGRATION=1
# NAVER_SAMPLE_XLSX=/tmp/synthetic_review.xlsx

# ── ESM+ live layer (Gmarket/Auction) ────────────────────────────────────────
# Live-only; not used by the offline core/tests. A human performs all login /
# 2FA / CAPTCHA — the collector never types ESM credentials.
#
# G0 (session/reconnect via `local-agent` → progressive-reconnect) REQUIRES all three
# of these for a runnable ESM browser connection. If ANY is unset, `local-agent`'s
# decideRun returns DRY_RUN and launches NO browser (it only validates/counts
# connections) — so G0 cannot reach a logged-in state.
#
# Two DISTINCT URL roles (never merge them; the probe URL never falls back to the auth URL):
#   ESM_AUTH_SURFACE_URL — login-form navigation + loginMode establishment + credential flow ONLY.
#     The ESM+ master/manager (ESM_PLUS) login surface — a PUBLIC URL, safe to check in; not a credential.
#   ESM_SESSION_PROBE_URL — the seller-center, session-gated surface; the ONLY navigation allowed to
#     produce a LOGGED_IN verdict (a bare login URL classifies as "login" and can never yield LOGGED_IN).
#     A PRIVATE seller-center URL — set it in your local .env, do NOT commit a real value. In practice
#     the same value already used as ESM_REVIEW_URL.
# STORAGE_PROBE_SALT is the sanitized session-fingerprint salt.
ESM_AUTH_SURFACE_URL=https://signin.esmplus.com/login
# ESM_SESSION_PROBE_URL=     # seller-center session-probe URL (operator-supplied; e.g. same as ESM_REVIEW_URL)
# STORAGE_PROBE_SALT=        # any non-secret random salt string (set in your local .env)
#
# Used by the (separate) review capture/classify CLIs — not by G0:
# ESM_REVIEW_URL=            # the ESM+ review-management/export page URL
# ESM_FRAME_ORIGIN_ALLOWLIST=  # comma-separated allowlisted vendor frame origins
# COLLECTOR_ESM_PROFILE_DIR= # dedicated ESM profile (default collector/.profile/esm)
