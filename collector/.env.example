# Copy to .env and run the CLI with:  node --env-file=.env ...  (or export these)
# These are SellerOps credentials for the LOCAL dev backend — NOT NAVER seller
# credentials. The collector never handles NAVER passwords; NAVER login happens
# manually in the browser profile during the (separate) live slice.

SELLEROPS_BASE_URL=http://localhost:8080
SELLEROPS_EMAIL=demo@sellerops.ai
SELLEROPS_PASSWORD=demo1234
NAVER_CHANNEL_CODE=NAVER

# Optional overrides (defaults are under collector/.profile, /downloads, /.status)
# COLLECTOR_PROFILE_DIR=
# COLLECTOR_DOWNLOAD_DIR=
# COLLECTOR_STATUS_FILE=

# Live layer only (not used by the offline core or offline tests). Required by
# `npm run discover -- --discover`: the review-management/export page URL. The
# exact URL is confirmed during the approved live milestone-1 run.
# NAVER_REVIEW_URL=

# Gated integration test only: absolute path to a SYNTHETIC NAVER-shaped export
# .xlsx (fake rows, unique 리뷰글번호 ids). NEVER point this at a real seller-center
# export — the file is ingested into the local dev DB.
# RUN_INTEGRATION=1
# NAVER_SAMPLE_XLSX=/tmp/synthetic_review.xlsx
