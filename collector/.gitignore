# Dependencies / build
node_modules/

# Local browser profile (holds the user's NAVER session — must NEVER be committed)
.profile/

# Captured export files and run status (local only)
downloads/
.status/

# Local connection registry store (holds connection records — local only)
.connections/

# Local Agent Bridge pairing store (holds pairing-token hashes — local only, never committed)
.bridge/

# Environment
.env

# Live-run findings artifacts may contain account-specific notes — keep local
findings/*.local.md

# Persisted Action Window Operation Runs (agent-local only, never committed)
.operation-runs/
