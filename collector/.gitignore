# Dependencies / build. NO trailing slash: in some worktrees this is a SYMLINK to a shared install, and a
# `node_modules/` pattern matches directories only — leaving an absolute-path symlink stageable by `git add -A`.
node_modules

# Local browser profile (holds the user's NAVER session — must NEVER be committed)
.profile/

# Captured export files and run status (local only)
downloads/
.status/

# Local connection registry store (holds connection records — local only)
.connections/

# Local Agent Bridge pairing store (holds pairing-token hashes — local only, never committed)
.bridge/

# Environment
.env

# Live-run findings artifacts may contain account-specific notes — keep local
findings/*.local.md

# Persisted Action Window Operation Runs (agent-local only, never committed)
.operation-runs/

# Persisted reply-submission runs (isolated v2 store, agent-local only, never committed)
.reply-runs/

# Import-run markers (v2 initial-review-import). Sanitized by design — no launch ref, no dates, no paths —
# but they are per-run local state, not source. The design called this dir gitignored from the start; the
# entry was missing until the first live run produced markers.
.import-runs/

# Guided reply target hint (privacy-safe match metadata, single-use, owner-only; never committed)
.reply-target/

# Action Window artifact quarantine (temporary validation saves, delete-after-validate; local only)
.aw-quarantine/

# Review-id reconciliation probe records (sanitized counts/enums only, but agent-local; never committed)
.review-id-runs/

# Guided reply session records (sanitized counts/enums only, but agent-local; never committed)
.guided-sessions/

# Calibrated seller-chrome selector specs (specifications only, never identity values)
.chrome-selectors/

# Store-identity diagnostic records (key names + digest prefixes only, but agent-local; never committed)
.store-identity-diagnostics/
