{
  "name": "@sellerops/collector",
  "private": true,
  "version": "0.0.1-poc",
  "type": "module",
  "description": "SellerOps NAVER Review Collector POC. Offline core + a live export-discovery layer (Playwright). Live NAVER runs are human-attended and require explicit per-run operator approval; the offline test suite needs no browser.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "connection": "tsx src/cli/connection.ts",
    "upload": "tsx src/cli/upload-file.ts",
    "discover": "tsx src/cli/discover-export.ts",
    "discover-same-session": "tsx src/cli/discover-same-session.ts",
    "probe-session": "tsx src/cli/probe-session.ts",
    "probe-same-session": "tsx src/cli/probe-same-session.ts",
    "probe-export-same-session": "tsx src/cli/probe-export-same-session.ts",
    "classify-export-same-session": "tsx src/cli/classify-export-same-session.ts",
    "classify-esm-review": "tsx src/cli/classify-esm-review.ts",
    "capture-esm-review": "tsx src/cli/capture-esm-review.ts",
    "probe-esm-session-ttl": "tsx src/cli/probe-esm-session-ttl.ts",
    "inspect-esm-review-xlsx": "tsx src/cli/inspect-esm-review-xlsx.ts",
    "compare-esm-overlap": "tsx src/cli/compare-esm-overlap.ts",
    "capture-export-same-session": "tsx src/cli/capture-export-same-session.ts",
    "diagnose-selection-state-same-session": "tsx src/cli/diagnose-selection-state-same-session.ts",
    "classify-account-store-same-session": "tsx src/cli/classify-account-store-same-session.ts",
    "continue-account-store-same-session": "tsx src/cli/continue-account-store-same-session.ts",
    "local-agent": "tsx src/cli/local-agent.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
